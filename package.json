{
	"name": "s-charts",
	"version": "0.6.0",
	"description": "Obsidian plugin: charts from a markdown table or note properties, in your theme colours.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node --test \"tests/**/*.test.ts\""
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "1.14.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"author": "Abdulkader Safi",
	"repository": {
		"type": "git",
		"url": "https://github.com/Abdulkader-Safi/obsidian-s-chart-plugins"
	},
	"dependencies": {
		"echarts": "^6.1.0"
	}
